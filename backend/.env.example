# Copy to `.env` and adjust for your environment.

# --- Core ---
SECRET_KEY=your-256-bit-secret-key-here
APP_ENV=development
DEBUG=true
APP_NAME=HMS API

# JWT (same algorithm name as in code: JWT_ALGORITHM)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BOOTSTRAP_ADMIN_TOKEN=

# --- Database (async PostgreSQL via asyncpg) ---
#
# Docker Compose (repo root: `docker compose up -d`) — default superuser is postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hms_db
#
# macOS Homebrew / Postgres.app (no OS user named "postgres"): omit DATABASE_URL in .env and the
# app defaults to postgresql+asyncpg://YOUR_MAC_USERNAME@127.0.0.1:5432/hms_db — create the DB once:
#   createdb hms_db
#
# When the API runs inside Docker Compose, use hostname `postgres` instead of localhost:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/hms_db

# --- CORS (comma-separated; required for cookie auth from the Next.js app) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-domain.vercel.app

# --- Redis / Celery ---
# Optional generic Redis URL (document only; the app uses CELERY_* below).
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/2
TRANSCRIBE_ASYNC_THRESHOLD_SECONDS=30

# --- AI transcription ---
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
WHISPER_LANGUAGE=

# --- S3-compatible object storage (e.g. Cloudflare R2) ---
# Map Cloudflare R2 dashboard values into these names:
#   CLOUDFLARE_R2_ENDPOINT        -> S3_ENDPOINT_URL
#   CLOUDFLARE_R2_ACCESS_KEY      -> S3_ACCESS_KEY_ID
#   CLOUDFLARE_R2_SECRET_KEY      -> S3_SECRET_ACCESS_KEY
#   CLOUDFLARE_R2_BUCKET_NAME     -> S3_BUCKET_NAME
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key
S3_SECRET_ACCESS_KEY=your-r2-secret-key
S3_BUCKET_NAME=hms-audio
S3_PUBLIC_BASE_URL=
