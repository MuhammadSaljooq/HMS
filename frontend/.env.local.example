# Copy to `.env.local` for local Next.js development.

# Target for `next.config` `/api/*` rewrites (browser calls same-origin `/api` so auth cookies work on the app host).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: override rewrite target only (defaults to NEXT_PUBLIC_API_URL).
# API_PROXY_TARGET=http://127.0.0.1:8000

# Server-side fetches (if any) can use a different internal URL.
# INTERNAL_API_URL=http://127.0.0.1:8000

NEXT_PUBLIC_APP_NAME=National Eye Care Hospital

# Must match backend cookie names if you override them in the API settings
NEXT_PUBLIC_ACCESS_TOKEN_COOKIE_NAME=access_token
NEXT_PUBLIC_REFRESH_TOKEN_COOKIE_NAME=refresh_token
